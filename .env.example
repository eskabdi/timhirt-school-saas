# Client (public — RLS applies)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Edge Function secrets — set with `supabase secrets set`; NEVER in the client bundle
# CHAPA_SECRET_KEY=
# CHAPA_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Deployed frontend origin — invite-tenant-admin uses this to build the
# invite email's redirectTo. Defaults to the production Vercel URL if unset,
# but must ALSO be added to the Supabase project's redirect-URL allow-list
# (Authentication -> URL Configuration) or Supabase silently falls back to
# the project's Site URL (http://localhost:3000 on a fresh project) instead.
# APP_URL=https://your-app.vercel.app
